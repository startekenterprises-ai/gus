<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
	GUS iOS — the app's real Info.plist (v0.17.0).

	Until v0.16.3 this plist was generated from INFOPLIST_KEY_*
	build settings (GENERATE_INFOPLIST_FILE), and the app icon
	came from the asset catalog (ASSETCATALOG_COMPILER_
	APPICON_NAME) — a combination that compiled cleanly yet
	shipped an icon the phone rendered as the system
	placeholder. The icon now ships as loose PNG files (the
	classic pre-catalog wiring, the same shape as the Mac's
	.icns path): build-ipa.sh generates them from the .b64
	master into the App folder at build time, and CFBundleIcons
	below names them. A physical plist is what lets
	CFBundleIconFiles be said at all — the generated-plist
	settings cannot express the nested dict.

	v0.17.3: this file lives at apps/ios/Info.plist, NOT inside
	App/. Inside the folder the file-system-synchronized App
	group also copied it as a bundle resource, and the copy
	collided with the processed plist ("Multiple commands
	produce …/GUS.app/Info.plist") — the v0.17.2 archive
	failed on exactly that (2026-11-20). INFOPLIST_FILE points
	here; nothing may move it back into App/.

	Every other key reproduces, value for value, the plist
	the generator produced for v0.16.3 (read out of the
	shipped .ipa), so nothing else about the app changes.
-->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>GUS</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIcons</key>
	<dict>
		<key>CFBundlePrimaryIcon</key>
		<dict>
			<key>CFBundleIconFiles</key>
			<array>
				<string>AppIcon60x60</string>
				<string>AppIcon1024</string>
			</array>
		</dict>
	</dict>
	<key>CFBundleIcons~ipad</key>
	<dict>
		<key>CFBundlePrimaryIcon</key>
		<dict>
			<key>CFBundleIconFiles</key>
			<array>
				<string>AppIcon76x76</string>
				<string>AppIcon83.5x83.5</string>
				<string>AppIcon1024</string>
			</array>
		</dict>
	</dict>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSMicrophoneUsageDescription</key>
	<string>GUS listens while you are on a call with it — that is the call. The microphone is live only during a call you started.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>GUS turns your speech into text during calls so it can answer you. Recognition runs on this iPhone whenever the system allows it.</string>
	<!--
		In-call camera (v0.36.0): the call screen's camera
		button captures ONE photo when the operator taps it —
		never automatically, never a stream — and sends it as
		that turn of the call. In Core mode it rides to the
		operator's own Mac like a chat photo; the on-device
		brain cannot see pictures and the call says so. This
		string is the system's ask, in context, at first tap.
	-->
	<key>NSCameraUsageDescription</key>
	<string>GUS uses the camera only when you tap the camera button on a call, to show GUS what you're looking at. Photos are never taken automatically.</string>
	<!--
		v0.27.2: the launch screen. Through 0.27.1 this plist
		carried NO launch-screen configuration at all — no
		UILaunchStoryboardName, no UILaunchScreen, and no
		LaunchScreen storyboard exists — so iOS ran the app in
		compatibility mode at a legacy resolution: letterboxed,
		scaled, visibly not filling the screen on Glenn's
		iPhone (field screenshot, 2026-11-27) while other apps
		filled theirs. The empty-storyboard UILaunchScreen
		dict below is what opts the app into native full
		resolution; its color names the LaunchBackground
		colorset in App/Assets.xcassets (the icon's navy), so
		the launch flash is brand navy rather than white.
	-->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<!--
		Background audio (v0.31.0): a live call keeps talking
		and hearing when the app leaves the foreground — the
		operator switches apps, locks the phone, or moves GUS
		aside mid-conversation. This declaration is the
		iOS-sanctioned path: with the audio background mode
		and the call's AVAudioSession active, the process is
		not suspended while the call runs. It declares
		nothing else — no background fetch, no location.
	-->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict/>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
